# Copia este fichero a .env y rellena los valores. .env no se sube a git.
# La aplicación no arranca si falta una variable obligatoria o si alguna no es válida.

# Puerto HTTP. Opcional (por defecto 3000).
PORT=3000

# Obligatoria. URL de PostgreSQL: postgres://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/ficheros

# Obligatoria. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Caducidad del token: segundos o con unidad s, m, h, d. Opcional (por defecto 1h).
JWT_EXPIRES_IN=1h

# Carpeta de los ficheros subidos; si es relativa, desde la raíz del proyecto. Opcional (por defecto ./uploads).
UPLOAD_DIR=./uploads

# Tamaño máximo por fichero en bytes. Opcional (por defecto 10485760 = 10 MB).
MAX_FILE_SIZE_BYTES=10485760

# Solo para los tests: base de datos propia. Opcional
# (por defecto, la base de datos local ficheros_test; ver tests/setupEnv.js).
# TEST_DATABASE_URL=
