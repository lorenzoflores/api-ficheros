# Copia este fichero a .env y rellena los valores. .env no se sube a git.
# La aplicación no arranca si falta una variable obligatoria o si alguna no es válida.

# Puerto HTTP. Opcional (por defecto 3000).
PORT=3000

# Obligatoria. URL de PostgreSQL: postgres://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/ficheros

# Obligatoria. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Caducidad del token: segundos o con unidad s, m, h, d. Opcional (por defecto 1h).
JWT_EXPIRES_IN=1h

# Carpeta de los ficheros subidos; si es relativa, desde la raíz del proyecto. Opcional (por defecto ./uploads).
UPLOAD_DIR=./uploads

# Tamaño máximo por fichero en bytes. Opcional (por defecto 10485760 = 10 MB).
MAX_FILE_SIZE_BYTES=10485760

# Número de proxies delante de la API cuyas cabeceras X-Forwarded-* se aceptan.
# 0 en local (sin proxy); 1 en Railway (su proxy). Un valor mayor que el real permite
# a un cliente falsear su IP enviando X-Forwarded-For. Opcional (por defecto 0).
TRUST_PROXY=0

# Nivel de los logs (pino): fatal, error, warn, info, debug, trace o silent.
# Opcional (por defecto info; silent en los tests).
LOG_LEVEL=

# Sentry (errores). Opcional: sin SENTRY_DSN no se envía nada.
# DSN del proyecto: https://<clave>@<host>/<proyecto>
SENTRY_DSN=
# Entorno con el que se etiquetan los errores. Opcional (por defecto, NODE_ENV).
SENTRY_ENVIRONMENT=

# Token que exige GET /metrics (Authorization: Bearer <token>), mínimo 16 caracteres.
# Opcional: sin él, /metrics responde 404. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=

# Solo para los tests: base de datos propia. Opcional
# (por defecto, la base de datos local ficheros_test; ver tests/setupEnv.js).
# TEST_DATABASE_URL=
